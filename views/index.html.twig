{% extends "layout.html.twig" %}

{% block title %}Home{% endblock %}

{% block content %}
	<div class="flex flex-row content-center wrap">
		{% for link in links %}
			<div class="flex-divide flex flex-col content-sb link-box">
			    <h2><a class="linkTitle" href="{{ path('link', { 'id': link.id }) }}">{{ link.title }}</a></h2>
			    <p>{{ link.desc }}</p>
				<div class="flex-end">
					<a href="{{ link.url }}" title="" target="_blank" class="link-btn">Open ></a>
					<em>(by {{ link.user.username }})</em>

					{% for tag in link.tags %}
						<a href="{{ path('tag', { 'id': tag.id }) }}" title="Filtrer" class="link-filter">
							{{ tag.title }}
						</a>
					{% endfor %}
				</div>
			    
			</div>
		{% endfor %}
	</div>

	{# Pagination #}
	{% if totalPages > 1 %}
	<nav aria-label="Page navigation" class="text-center" style="margin-top: 30px;">
		<ul class="pagination">
			{% if currentPage > 1 %}
			<li>
				<a href="{{ path('home', {'page': currentPage - 1}) }}" aria-label="Previous">
					<span aria-hidden="true">&laquo;</span>
				</a>
			</li>
			{% endif %}
			
			{% for page in 1..totalPages %}
			<li {% if page == currentPage %}class="active"{% endif %}>
				<a href="{{ path('home', {'page': page}) }}">{{ page }}</a>
			</li>
			{% endfor %}
			
			{% if currentPage < totalPages %}
			<li>
				<a href="{{ path('home', {'page': currentPage + 1}) }}" aria-label="Next">
					<span aria-hidden="true">&raquo;</span>
				</a>
			</li>
			{% endif %}
		</ul>
	</nav>
	{% endif %}
{% endblock %}
